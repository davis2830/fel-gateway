# fel-gateway runtime configuration. Copy to .env and fill in real values.

# --- Database ---
DATABASE_URL=postgresql+psycopg://felgateway:felgateway@db:5432/felgateway

# --- Celery / RabbitMQ ---
CELERY_BROKER_URL=amqp://felgateway:felgateway@rabbitmq:5672//
CELERY_RESULT_BACKEND=db+postgresql+psycopg://felgateway:felgateway@db:5432/felgateway

# --- Auth ---
# Master key required to call /admin/tenants endpoints (tenant CRUD + key rotation).
# MUST be a long, random string in production. NEVER commit a real value here.
MASTER_API_KEY=change-me-to-a-long-random-string

# --- Logging ---
LOG_LEVEL=INFO

# --- Provider timeouts (seconds) ---
PROVIDER_TIMEOUT=30
